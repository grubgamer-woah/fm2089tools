rules_version = '2';
// Only people on the team list (meta/access) can read or change the script.
// The first person to sign in on a new database can make themselves its admin;
// after that only admins change the team list or upload a new pack.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }
    function accessPath() { return /databases/$(db)/documents/meta/access; }
    function hasTeam() { return exists(accessPath()); }
    function isAdmin() { return signedIn() && hasTeam() && me() in get(accessPath()).data.admins; }
    // reviewers accept or reject suggestions and change the script directly, but don't run the team or upload packs
    function isReviewer() {
      return signedIn() && hasTeam() && (me() in get(accessPath()).data.admins || me() in get(accessPath()).data.get('reviewers', []));
    }
    function isEditor() {
      return signedIn() && hasTeam() && (me() in get(accessPath()).data.editors || me() in get(accessPath()).data.admins
                                         || me() in get(accessPath()).data.get('reviewers', []));
    }

    // anyone on the team may set their own username once (shown instead of their Google name), and nothing else
    function okName(v) { return v is string && v.size() >= 1 && v.size() <= 24; }
    function setsOwnUsername() {
      return isEditor() && !(me() in resource.data.get('usernames', {}))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usernames', 'names'])
        && request.resource.data.get('usernames', {}).diff(resource.data.get('usernames', {})).affectedKeys().hasOnly([me()])
        && request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys().hasOnly([me()])
        && okName(request.resource.data.usernames[me()]);
    }

    match /meta/access {
      allow get: if isEditor() || (signedIn() && !hasTeam());
      allow create: if signedIn() && !hasTeam() && request.resource.data.admins == [me()]
                    && request.resource.data.editors == [];
      // an admin can't remove the last admin or themselves
      allow update: if (isAdmin() && me() in request.resource.data.admins) || setsOwnUsername();
    }
    // the script itself: everyone on the team reads it, admins and reviewers change it (editors'
    // changes go in as suggestions they review); only admins upload packs (script, font, portraits)
    match /meta/{doc} {
      allow read: if isEditor() && doc != 'access';
      allow write: if isAdmin() && doc != 'access';
      allow update: if isReviewer() && doc in ['speakers', 'project'];
      allow create: if isReviewer() && doc == 'project';
    }
    match /files/{file} {
      allow read: if isEditor();
      allow write: if isAdmin();
      allow update: if isReviewer();
    }
    // A suggestion: made by its author while waiting for review (they may change or withdraw it then);
    // an admin accepts, modifies or rejects it. Afterwards its author may only mark the answer as read.
    match /suggestions/{item} {
      allow read: if isEditor();
      allow create: if isEditor() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.e == me() && request.resource.data.status == 'pending';
      allow update: if isReviewer()
                    || (isEditor() && resource.data.uid == request.auth.uid && resource.data.status == 'pending'
                        && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending')
                    || (isEditor() && resource.data.uid == request.auth.uid && resource.data.status != 'pending'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']));
      allow delete: if isReviewer() || (isEditor() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }
    // claims/{id}: someone's missions or lines for a week (the page ignores older ones); its owner renews or
    // releases it, and reviewers can release anyone's
    match /claims/{id} {
      allow read: if isEditor();
      allow create: if isEditor() && request.resource.data.uid == request.auth.uid && request.resource.data.e == me();
      allow update: if isEditor() && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t']);
      allow delete: if isReviewer() || (isEditor() && resource.data.uid == request.auth.uid);
    }
    // accessRequests/{uid}: someone not on the team asks to join; an admin approves (adding them under
    // meta/access) or declines. The asker sees only their own request.
    match /accessRequests/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow read: if isAdmin();
      allow create: if signedIn() && uid == request.auth.uid && request.resource.data.uid == uid
                    && request.resource.data.e == me() && request.resource.data.status == 'pending'
                    && request.resource.data.role in ['editors', 'reviewers'] && okName(request.resource.data.n);
      allow update: if isAdmin()
                    || (signedIn() && uid == request.auth.uid && resource.data.status != 'pending'
                        && request.resource.data.status == 'pending' && request.resource.data.e == me()
                        && request.resource.data.role in ['editors', 'reviewers'] && okName(request.resource.data.n));
      allow delete: if isAdmin() || (signedIn() && uid == request.auth.uid && resource.data.status == 'pending');
    }
    match /history/{item} {
      allow read: if isEditor();
      allow create: if isEditor() && request.resource.data.e == me();
    }
    match /presence/{uid} {
      allow read: if isEditor();
      allow write: if isEditor() && uid == request.auth.uid;
    }
  }
}
